{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zenbuy",
  "main": "src/worker/index.ts",
  "account_id": "7841b36fdc9d3c3ae48bd119503d3df5",
  "compatibility_date": "2025-08-24",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs: ingest console.log (unlock_trace, etc.) into Observability.
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e7da16eeb3dd4ce995d1b97b813a7847"
    }
  ],
  "vars": {
    "ZENBUY_MODEL": "grok-4.7",
    "ZENBUY_PRIMARY_PROVIDER": "xai",
    "ZENBUY_BACKUP_MODEL": "claude-sonnet-5-5",
    "ZENBUY_BACKUP_PROVIDER": "anthropic",
    // Grok 4.7 hidden reasoning before the first token: low ~5s, medium ~27s,
    // high ~57s on a small prompt (minutes on a full report). low | medium | high.
    "ZENBUY_XAI_REASONING_EFFORT": "low",
    // Free web/app allowance: reports per visitor per rolling 7 days, counted
    // per identity cluster (zb_vid cookie + device signal + network), not
    // per IP. Unlocked buyers are counted per Apple subject, per day.
    "RATE_LIMIT_FREE_WEEKLY": "3",
    "RATE_LIMIT_PRO_DAILY": "25",
    // First-party ops (X-ZenBuy-Ops + HEALTHCHECK_TOKEN secret) daily ceiling.
    // Keeps a stuck healthcheck from draining LLM spend; never shares free/pro.
    "RATE_LIMIT_OPS_DAILY": "100",
    "CACHE_TTL_SECONDS": "3600",
    // Sign in with Apple. APPLE_KEY_ID and APPLE_PRIVATE_KEY are Worker
    // secrets; everything here is public by design (the Services ID travels
    // in the redirect to Apple, the team id ships in the iOS build).
    "APPLE_SERVICES_ID": "info.zenbuy.web",
    "APPLE_TEAM_ID": "XQP4QUVJYY",
    "APPLE_BUNDLE_ID": "info.zenbuy.app",
    "APPLE_PRO_PRODUCT_IDS": "info.zenbuy.app.lifetime,info.zenbuy.app.pro.monthly",
    // TestFlight purchases run through Apple's sandbox. Set to "0" once the
    // app is selling on the App Store.
    "APPLE_ALLOW_SANDBOX": "1",
    // TestFlight complimentary unlock (verified sandbox AppTransaction).
    // "0" pauses NEW grants so App Review, which runs in the same sandbox,
    // reaches the Monthly / Buy once paywall (Guideline 2.1(b)). Existing
    // grants and sessions stay valid; sandbox IAP purchases and the whitelist
    // are unaffected. Set back to "1" once tvOS 1.7 is approved.
    "TESTFLIGHT_COMPLIMENTARY": "1",
    // Complimentary unlock, no App Store purchase, and never counted against
    // any report limit. Comma-separated; each entry is either an email address
    // (matched case-insensitively against the claim Apple sends) or
    // "sub:<apple subject id>" for when the address is hidden.
    //   "someone@example.com,sub:001234.abc...def.5678"
    "APPLE_ID_WHITELIST": "tdmorgenthaler@icloud.com,thalerz@me.com,thalerz@icloud.com",
    // Public download URL for the header "Get the App" pill and the unlock
    // guide store row. Official App Store listing now that the app is
    // generally available. Empty hides both surfaces.
    "APP_STORE_URL": "https://apps.apple.com/app/id6807960678",
    // From header for the Apple TV "Email PDF" control. Must be a domain
    // verified for sending in Resend; move to reports@zenbuy.info once that
    // domain is verified. The RESEND_API_KEY beside it is a Worker secret.
    "REPORT_EMAIL_FROM": "ZenBuy Reports <zenbuy@cybermansoft.com>"
  },
  "routes": [
    {
      "pattern": "zenbuy.info",
      "custom_domain": true
    },
    {
      "pattern": "www.zenbuy.info",
      "custom_domain": true
    }
  ]
}
