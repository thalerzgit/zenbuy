{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zenbuy",
  "main": "src/worker/index.ts",
  "account_id": "7841b36fdc9d3c3ae48bd119503d3df5",
  "compatibility_date": "2025-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e7da16eeb3dd4ce995d1b97b813a7847"
    }
  ],
  "vars": {
    "ZENBUY_MODEL": "claude-opus-5",
    "ZENBUY_BACKUP_MODEL": "grok-4.5",
    "ZENBUY_BACKUP_PROVIDER": "xai",
    "RATE_LIMIT_DAILY": "5",
    "RATE_LIMIT_WHITELIST": "99.0.81.158,73.15.8.74",
    "CACHE_TTL_SECONDS": "3600"
  },
  "routes": [
    {
      "pattern": "zenbuy.info",
      "custom_domain": true
    },
    {
      "pattern": "www.zenbuy.info",
      "custom_domain": true
    }
  ]
}
