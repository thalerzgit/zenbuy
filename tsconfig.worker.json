{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/worker/**/*.ts", "src/lib/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["src/worker/**/*.test.ts"]
}
