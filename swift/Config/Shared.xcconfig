// ZenBuy iOS — shared build settings

PRODUCT_NAME = ZenBuy
PRODUCT_BUNDLE_IDENTIFIER = info.zenbuy.app
DEVELOPMENT_TEAM = XQP4QUVJYY
MARKETING_VERSION = 1.8
// Apple TV stays on 1.7 until its App Store review (1.7) is decided.
// Kept here (not TVOS.xcconfig) so this change does not trigger the tvOS workflow.
MARKETING_VERSION[sdk=appletvos*] = 1.7
MARKETING_VERSION[sdk=appletvsimulator*] = 1.7
CURRENT_PROJECT_VERSION = 128

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator

SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete

// Production API (override in Debug for local Worker if needed)
ZENBUY_API_BASE_URL = https:/$()/zenbuy.info

// Sign in with Apple (Unlock Web) rides on an entitlement, and TestFlight
// archives are signed manually against a fixed provisioning profile — so the
// archive fails unless that profile also carries the capability. It stays off
// here until the App ID and the CI profile have both been updated; see
// docs/APPLE_UNLOCK_SETUP.md. Then set:
//   ZENBUY_ENTITLEMENTS = ZenBuy/ZenBuy.entitlements
// CI does the same thing without a code change via the repository variable
// IOS_SIGN_IN_WITH_APPLE=1.
ZENBUY_ENTITLEMENTS =
CODE_SIGN_ENTITLEMENTS = $(ZENBUY_ENTITLEMENTS)
